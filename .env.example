# morning-triage configuration. Copy to .env and edit. Nothing here is secret;
# .env is gitignored anyway. Values with $HOME are expanded by setup.sh / your shell.

# ---- Identity: which messages count as "from you" (closure detection) ----
# Auto-filled by /morning-triage:setup, which reads your display name from the signed-in
# Microsoft 365 session. Set it by hand only if auto-detection fails: ';'-separated
# fragments of your display name, e.g. "doe;jane;jdoe".
MT_MY_NAME_TOKENS=""

# ---- Zoom portal ----
# The generic host serves recordings AND summaries for most accounts — normally leave as is.
# Override only if your org requires its vanity host, e.g. https://acme.zoom.us
MT_ZOOM_BASE="https://zoom.us"

# ---- Where runtime state + digests live (defaults are fine; kept OUTSIDE the repo) ----
MT_STATE_DIR="$HOME/.morning-triage"
MT_LOG_DIR="$HOME/morning-triage-logs"

# ---- Language to write the digest in ----
MT_DIGEST_LANG="English"

# ---- Optional: a codebase to verify factual answers against before drafting replies ----
# MT_WORKSPACE_DIR="$HOME/work/myrepo"

# ---- How far back the FIRST look goes ----
# Days to look back the first time a Teams conversation is seen. After that, each conversation
# resumes from its own watermark (i.e. from where you last read), so nothing is re-triaged.
MT_FIRST_RUN_DAYS="3"

# ---- Mail hygiene (optional; WRITES to your mailbox) ----
# 1 = after the digest is written, mark the mail that was triaged as read.
# Teams conversations are already marked read as a side effect of opening them; mail is not.
MT_MARK_MAIL_READ="0"

# ---- Teams scrape tuning (optional; safe defaults) ----
# TEAMS_CHAT_SINCE=""          # override the first-look start (ISO or 'YYYY-MM-DDTHH:MM')
# TEAMS_RAIL_MIN="10"          # min chat-rail rows before trusting coverage (render-race guard)
# TEAMS_CHAT_BUDGET_S="1200"   # wall-clock cap (seconds) for the whole chat phase

# ---- Optional integration: Jira (file issues for genuinely new work) ----
MT_JIRA_ENABLED="0"
# MT_JIRA_PROJECT="PROJ"
# MT_JIRA_ASSIGNEE_ACCOUNT_ID=""

# ---- Optional integration: Slack (post the digest summary to a channel) ----
MT_SLACK_ENABLED="0"
# MT_SLACK_CHANNEL_ID="C0XXXXXXXXX"
